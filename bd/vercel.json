{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bd-onboarding.vercel.app"
        }
      ],
      "destination": "https://bd-onboarding-barefootinc.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bd-onboarding-shima-s-projects2.vercel.app"
        }
      ],
      "destination": "https://bd-onboarding-barefootinc.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bd-dashboard-mu.vercel.app"
        }
      ],
      "destination": "https://bd-onboarding-barefootinc.vercel.app/:path*",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "bd-dashboard-barefootinc-th.vercel.app"
        }
      ],
      "destination": "https://bd-onboarding-barefootinc.vercel.app/:path*",
      "permanent": false
    }
  ]
}
