{
  "sounds": [
    {"id":"i_long","symbol":"iː","type":"vowel","nameJa":"長い「イー」","hint":"口を横に引いて緊張させる。日本語の「イ」より鋭く長い。","spelling":["ee","ea","e_e","ie"],"examples":[{"word":"sheep","ipa":"/ʃiːp/"},{"word":"leave","ipa":"/liːv/"},{"word":"receipt","ipa":"/rɪˈsiːt/"}]},
    {"id":"i_short","symbol":"ɪ","type":"vowel","nameJa":"短い「イ」（エ寄り）","hint":"口の力を抜いて「イ」と「エ」の間。日本語の「イ」より緩い。","spelling":["i","y","ui"],"examples":[{"word":"ship","ipa":"/ʃɪp/"},{"word":"live","ipa":"/lɪv/"},{"word":"build","ipa":"/bɪld/"}]},
    {"id":"ae","symbol":"æ","type":"vowel","nameJa":"「ア」と「エ」の間","hint":"口を大きく横に開いて「エ」の口で「ア」。cat, bad。","spelling":["a"],"examples":[{"word":"cat","ipa":"/kæt/"},{"word":"bad","ipa":"/bæd/"},{"word":"manager","ipa":"/ˈmænɪdʒər/"}]},
    {"id":"uh","symbol":"ʌ","type":"vowel","nameJa":"短い「ア」（喉の奥）","hint":"口を小さく開けて喉の奥で短く「ア」。cut, bus。","spelling":["u","o","ou"],"examples":[{"word":"cut","ipa":"/kʌt/"},{"word":"money","ipa":"/ˈmʌni/"},{"word":"customer","ipa":"/ˈkʌstəmər/"}]},
    {"id":"a_long","symbol":"ɑː","type":"vowel","nameJa":"口を大きく開けた「アー」","hint":"あくびの口。医者で「アー」と言うときの音。hot（米）, father。","spelling":["o","a","ar"],"examples":[{"word":"hot","ipa":"/hɑːt/"},{"word":"father","ipa":"/ˈfɑːðər/"},{"word":"stock","ipa":"/stɑːk/"}]},
    {"id":"schwa","symbol":"ə","type":"vowel","nameJa":"あいまい母音（シュワ）","hint":"英語で一番多い母音。力を抜いて口を半開き、はっきり言わない。アクセントのない音節はほぼこれ。","spelling":["a","e","o","u"],"examples":[{"word":"about","ipa":"/əˈbaʊt/"},{"word":"customer","ipa":"/ˈkʌstəmər/"},{"word":"support","ipa":"/səˈpɔːrt/"}]},
    {"id":"er","symbol":"ɜːr","type":"vowel","nameJa":"「アー」＋ R（舌を巻く）","hint":"舌先をどこにも付けずに持ち上げて「アー」。work, first, learn。","spelling":["er","ir","ur","or","ear"],"examples":[{"word":"work","ipa":"/wɜːrk/"},{"word":"first","ipa":"/fɜːrst/"},{"word":"learn","ipa":"/lɜːrn/"}]},
    {"id":"u_long","symbol":"uː","type":"vowel","nameJa":"長い「ウー」（唇を丸める）","hint":"唇をしっかり突き出して丸める。日本語の「ウ」は唇が平ら。","spelling":["oo","u_e","ew","ue"],"examples":[{"word":"shoe","ipa":"/ʃuː/"},{"word":"food","ipa":"/fuːd/"},{"word":"new","ipa":"/nuː/"}]},
    {"id":"u_short","symbol":"ʊ","type":"vowel","nameJa":"短い「ウ」（緩め）","hint":"口の力を抜いた短い「ウ」。foot, good, put。","spelling":["oo","u","ou"],"examples":[{"word":"foot","ipa":"/fʊt/"},{"word":"good","ipa":"/ɡʊd/"},{"word":"put","ipa":"/pʊt/"}]},
    {"id":"o_long","symbol":"ɔː","type":"vowel","nameJa":"「オー」（口を縦に開ける）","hint":"口を縦に大きく開けて「オー」。walk, store, call。","spelling":["aw","au","or","al"],"examples":[{"word":"walk","ipa":"/wɔːk/"},{"word":"store","ipa":"/stɔːr/"},{"word":"call","ipa":"/kɔːl/"}]},
    {"id":"ei","symbol":"eɪ","type":"vowel","nameJa":"「エイ」（二重母音）","hint":"「エ」から「イ」へ滑らかに。日本語の「エー」と伸ばさない。","spelling":["a_e","ai","ay","eigh"],"examples":[{"word":"sale","ipa":"/seɪl/"},{"word":"wait","ipa":"/weɪt/"},{"word":"day","ipa":"/deɪ/"}]},
    {"id":"ou","symbol":"oʊ","type":"vowel","nameJa":"「オウ」（二重母音）","hint":"「オ」から「ウ」へ。日本語の「オー」と伸ばすと通じにくい。go, know, sole。","spelling":["o_e","oa","ow","o"],"examples":[{"word":"go","ipa":"/ɡoʊ/"},{"word":"know","ipa":"/noʊ/"},{"word":"sole","ipa":"/soʊl/"}]},
    {"id":"ai","symbol":"aɪ","type":"vowel","nameJa":"「アイ」（二重母音）","hint":"size, price, buy。「ア」をはっきり大きく。","spelling":["i_e","y","igh","uy"],"examples":[{"word":"size","ipa":"/saɪz/"},{"word":"price","ipa":"/praɪs/"},{"word":"buy","ipa":"/baɪ/"}]},
    {"id":"au","symbol":"aʊ","type":"vowel","nameJa":"「アウ」（二重母音）","hint":"「ア」から唇を丸めて「ウ」。how, about, discount。","spelling":["ou","ow"],"examples":[{"word":"how","ipa":"/haʊ/"},{"word":"about","ipa":"/əˈbaʊt/"},{"word":"discount","ipa":"/ˈdɪskaʊnt/"}]},
    {"id":"r","symbol":"r","type":"consonant","nameJa":"R（舌を巻く・付けない）","hint":"舌先をどこにも付けず、唇を少し丸める。日本語のラ行は舌先が上に当たる（＝英語の l / t に近い）。","spelling":["r","wr","rr"],"examples":[{"word":"right","ipa":"/raɪt/"},{"word":"run","ipa":"/rʌn/"},{"word":"receipt","ipa":"/rɪˈsiːt/"}]},
    {"id":"l","symbol":"l","type":"consonant","nameJa":"L（舌先を上の歯茎に付ける）","hint":"舌先を上の前歯の裏にしっかり付けたまま声を出す。語尾の l（feel, sell）は暗く「ウ」のよう。","spelling":["l","ll"],"examples":[{"word":"light","ipa":"/laɪt/"},{"word":"sell","ipa":"/sel/"},{"word":"flexible","ipa":"/ˈfleksəbəl/"}]},
    {"id":"th_v","symbol":"ð","type":"consonant","nameJa":"TH（有声・舌を噛む「ズ」）","hint":"舌先を上下の歯で軽く挟んで声を出す。the, this, that, mother。","spelling":["th"],"examples":[{"word":"the","ipa":"/ðə/"},{"word":"this","ipa":"/ðɪs/"},{"word":"weather","ipa":"/ˈweðər/"}]},
    {"id":"th_u","symbol":"θ","type":"consonant","nameJa":"TH（無声・舌を噛む「ス」）","hint":"舌先を歯で挟んで息だけ。think, thanks, both。s と区別する。","spelling":["th"],"examples":[{"word":"think","ipa":"/θɪŋk/"},{"word":"thanks","ipa":"/θæŋks/"},{"word":"month","ipa":"/mʌnθ/"}]},
    {"id":"v","symbol":"v","type":"consonant","nameJa":"V（下唇を噛んで声）","hint":"上の前歯を下唇に軽く当てて声を出す。b は唇を閉じる。very / berry。","spelling":["v","ve"],"examples":[{"word":"very","ipa":"/ˈveri/"},{"word":"have","ipa":"/hæv/"},{"word":"inventory","ipa":"/ˈɪnvəntɔːri/"}]},
    {"id":"f","symbol":"f","type":"consonant","nameJa":"F（下唇を噛んで息）","hint":"v と同じ口で息だけ。日本語の「フ」は唇を噛まない（両唇音）。","spelling":["f","ff","ph","gh"],"examples":[{"word":"foot","ipa":"/fʊt/"},{"word":"office","ipa":"/ˈɔːfɪs/"},{"word":"enough","ipa":"/ɪˈnʌf/"}]},
    {"id":"s_sh","symbol":"ʃ","type":"consonant","nameJa":"SH（唇を丸めた「シュ」）","hint":"she, shoe, sure。s（see）との区別：s は唇を丸めない。","spelling":["sh","ti","ci","ssi"],"examples":[{"word":"shoe","ipa":"/ʃuː/"},{"word":"sure","ipa":"/ʃʊr/"},{"word":"position","ipa":"/pəˈzɪʃən/"}]},
    {"id":"s","symbol":"s","type":"consonant","nameJa":"S（鋭い「ス」）","hint":"see, sit, size。日本語の「シ」（si）は英語では shi に聞こえがち → sit を shit と言わないように。","spelling":["s","ss","c","ce"],"examples":[{"word":"sit","ipa":"/sɪt/"},{"word":"size","ipa":"/saɪz/"},{"word":"receipt","ipa":"/rɪˈsiːt/"}]},
    {"id":"z","symbol":"z","type":"consonant","nameJa":"Z（有声の S）","hint":"s の口で声を出す。複数形の -s は多くが z：shoes /ʃuːz/, sizes /ˈsaɪzɪz/。","spelling":["z","s","ss"],"examples":[{"word":"zero","ipa":"/ˈzɪroʊ/"},{"word":"shoes","ipa":"/ʃuːz/"},{"word":"because","ipa":"/bɪˈkɔːz/"}]},
    {"id":"w","symbol":"w","type":"consonant","nameJa":"W（唇を強く丸めて）","hint":"唇を「ウ」より強く突き出してから開く。would, work, wear。","spelling":["w","wh"],"examples":[{"word":"would","ipa":"/wʊd/"},{"word":"work","ipa":"/wɜːrk/"},{"word":"wear","ipa":"/wer/"}]},
    {"id":"ng","symbol":"ŋ","type":"consonant","nameJa":"NG（鼻にかける「ン」、g は言わない）","hint":"舌の奥を上げて鼻から。sing, going, thing。語尾に g の音を付けない。","spelling":["ng","n(k)"],"examples":[{"word":"going","ipa":"/ˈɡoʊɪŋ/"},{"word":"thing","ipa":"/θɪŋ/"},{"word":"thank","ipa":"/θæŋk/"}]}
